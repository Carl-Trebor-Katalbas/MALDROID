<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_ethereal"
    tools:context=".RecentScansFragment">

    <!-- Title -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexenddeca_variablefont_wght"
            android:gravity="center"
            android:text="Recent Scans"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="normal" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Scrollable RecyclerView for scan items with shadow and scrollbar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="625dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#B3FFFFFF"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"
        app:layout_constraintVertical_bias="0.0">

        <androidx.recyclerview.widget.RecyclerView
            android:background="@drawable/custom_button2"
            android:id="@+id/scanHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="615dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:fadeScrollbars="false"
            android:padding="14dp"
            android:scrollbars="vertical" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/clearButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>